# Copy this file to `.env` and fill in your keys:
#   cp .env.example .env

# --- Required for --live ---
# Anthropic API key for Claude Haiku 5.5 (claude-haiku-5-5)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: OpenAI Decisions (intent, tool selection, model routing) ---
# Used by `intent`, `auto`, `--selector`, and `--route`. Without a key the app
# uses its deterministic offline fallbacks.
OPENAI_API_KEY=
DECISIONS_API_KEY=
GTM_DECISION_BACKEND=auto          # auto | openai | offline
GTM_DECISION_MODEL=gpt-6-luna
GTM_INTENT_CONFIDENCE_FLOOR=0.65
GTM_TOOL_SELECTION_MAX_TOOLS=6
GTM_TOOL_SELECTION_THRESHOLD=0.5

# --- Optional: model routing provider keys (--route) ---
# Each tier only becomes routable if its provider key is configured:
#   fast        glm-5.3-flash, deepseek-4-flash   (Fireworks)
#   balanced    gpt-6-luna                        (OpenAI)
#   performance claude-haiku-5-5                  (Anthropic)
FIREWORKS_API_KEY=

# --- Optional: LangSmith tracing (see the LangChain GTM agent blog post) ---
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=gtm-agent-sample

# --- Optional: code interpreter for the deep agent (programmatic tool calling) ---
# `build_interpreter_agent` wires `CodeInterpreterMiddleware` (deepagents[quickjs]
# -> langchain-quickjs); the model then authors JS against an allowlisted `tools` namespace.
# Install:  uv pip install "deepagents[quickjs]>=0.7.23"
# The allowlist is derived per skill by gtm_agent/ptc.py; action tools stay
# on the normal HITL-gated path.

# --- Optional overrides ---
# Model ID if you want to try a different Claude model
# GTM_MODEL_ID=claude-haiku-5-5
